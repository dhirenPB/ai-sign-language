      "sentence_id": "01-csu-bakersfield-english-session-s0021",
      "source_text": "His community sees him as a Jain saint whose thoughts, words, and work are an inspiration for people around the world.",
      "start_timestamp": null,
      "end_timestamp": null,
      "speaker_id": "Speaker 1",
      "turn_index": 2,
      "incomplete": false,
      "depends_on_previous": true,
      "dependency_reasons": [
