        "cue_indices": null,
        "cue_ids": null
      }
    },
    {
      "sentence_id": "01-csu-bakersfield-english-session-s0022",
      "source_text": "For his community, he's not only a profound visionary, but also humanitarian, working to engender a positive difference in countless lives globally.",
      "start_timestamp": null,
      "end_timestamp": null,
      "speaker_id": "Speaker 1",
      "turn_index": 2,
      "incomplete": false,
      "depends_on_previous": false,
