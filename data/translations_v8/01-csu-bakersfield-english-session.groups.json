        "cue_indices": null,
        "cue_ids": null
      }
    },
    {
      "sentence_id": "01-csu-bakersfield-english-session-s0023",
      "source_text": "He's the founder of Parastham, a socio-religious organization in India with humanitarian initiatives and spiritually uplifting missions across the world.",
      "start_timestamp": null,
      "end_timestamp": null,
      "speaker_id": "Speaker 1",
      "turn_index": 2,
      "incomplete": false,
      "depends_on_previous": false,
      "dependency_reasons": [],
