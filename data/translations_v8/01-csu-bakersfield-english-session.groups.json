      "sentence_id": "01-csu-bakersfield-english-session-s0020",
      "source_text": "So, the leading guru or teacher, as my students should know, for the community of Jains we'll be learning from, is Rashtrasant Param Gurudev Sri Namramuni Maharaj Sahi.",
      "start_timestamp": null,
      "end_timestamp": null,
      "speaker_id": "Speaker 1",
      "turn_index": 2,
      "incomplete": false,
      "depends_on_previous": true,
